# OpenAI prepares case briefs, extracts outcomes and assesses repair photos.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.4-mini
OPENAI_EVIDENCE_MODEL=gpt-5.4-mini

# Citizen speech stays server-side; no browser API keys.
SARVAM_API_KEY=
OPENAI_CITIZEN_MODEL=gpt-5.4-mini
OPENAI_TRANSLATION_MODEL=gpt-5.4-mini

# Bolna handles outbound stakeholder calls with GPT Realtime.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
APP_BASE_URL=
BOLNA_TOOL_SECRET=
BOLNA_VOICE_MODEL=gpt-realtime-2.1
BOLNA_VOICE=marin
BOLNA_LANGUAGE=mr
# Optional phone demo: configure your own consenting recipient, never a directory number.
BOLNA_DEMO_PHONE=
BOLNA_DEMO_CALL_AUTHORIZED=false
BOLNA_FROM_PHONE=
BOLNA_DEMO_NAME=Aarav Patil (demo)
# Status check delay when a completed conversation supplies no dated promise (1–168 hours).
FOLLOW_UP_DEFAULT_HOURS=24

# Optional extra trusted provider recording hosts, comma-separated.
BOLNA_RECORDING_HOSTS=
