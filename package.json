{
  "name": "metrohack",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:demo": "node --import tsx scripts/populate-demo.ts",
    "vercel-build": "npm run db:demo && next build --webpack",
    "voice:configure": "node --env-file-if-exists=.env.local --import tsx scripts/configure-voice.ts",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/voice-worker.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.101",
    "@base-ui/react": "^1.9.0",
    "@bolna/web-call": "^3.0.1",
    "@openai/agents": "^0.21.0",
    "@phosphor-icons/react": "^2.1.10",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "ai": "^7.0.152",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
